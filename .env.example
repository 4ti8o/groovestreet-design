# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value below is OPTIONAL - the site
# renders and works without them (contact form falls back to email/WhatsApp
# handoff links). Defaults that ship in code live in src/lib/site.ts.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata + sitemap + JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact details. Phone numbers must be E.164 (digits only, no +, spaces or dashes).
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE_E164=""
NEXT_PUBLIC_WHATSAPP_E164=""

# Optional booking link (Cal.com / Calendly). Adds a "Book a call" option.
NEXT_PUBLIC_CALENDAR_URL=""

# Where contact-form submissions are delivered. Accepts any endpoint that takes
# a JSON POST (Formspree, Getform, Basin, Make/Zapier webhook, your own API).
# When empty, the form renders "send via email" / "send via WhatsApp" buttons
# prefilled with what the visitor typed instead of submitting.
CONTACT_FORM_ENDPOINT=""

# Optional cookieless analytics (Plausible / Umami). Left empty = no script.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
